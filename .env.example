# meblog 根目录 .env —— 只给 docker compose 做变量插值用
# 用法（服务器上）：cp .env.example .env，改值，然后
#   docker compose -f docker-compose-frontend-production.yml -p meblog-prod up -d --build
#
# 注意：这里的值不会进后端容器。后端读的是 backend/.env.production（打包进镜像），
# 前端读的是这份 compose 传进去的运行时环境变量 —— 两边的 SITE_URL 必须一字不差相同。
#
# 站点对外地址（当前线上漏配就是它，导致 sitemap/robots/RSS 全输出 localhost）
# 换域名时改这里 + backend/.env.production 的 SITE_URL，两边必须一字不差。
# 注意 robots.txt 是构建时生成的静态文件，改完这一行要重新构建前端才跟得上；
# / 和 /sitemap.xml 这些服务端渲染的路径运行时就读到了。
SITE_URL=http://meblog.bugooai.cn
NEXT_PUBLIC_ENV=production

# 前端运行时取后端数据用的地址。留空时：
#   production -> 用这份 compose 里的默认值 http://memblog-backend-prod:8000/api/v1
#   test       -> 退回 app/lib/server-api.ts 里按 NEXT_PUBLIC_ENV=test 挑的 http://memblog-backend:8000/api/v1
SERVER_API_BASE_URL=

# 发文后即时刷新首页缓存。必须等于 backend/.env.production 里的 FRONTEND_REVALIDATE_TOKEN。
# 留空则该接口一律 401，首页最长 180 秒后才更新。
REVALIDATE_SECRET=
