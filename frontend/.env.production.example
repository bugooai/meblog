# meblog 前端生产环境变量（复制到服务器上的 frontend/.env.production）
# 站点：http://meblog.bugooai.cn   （nginx/1.18.0 Ubuntu，只开了 80，没有 HTTPS）
#
# 关键：NEXT_PUBLIC_* 是**构建时**烘进产物的，改完必须重新构建镜像才生效，
# 光 restart 容器没用：
#   docker compose -f docker-compose-frontend-production.yml -p meblog-prod up -d --build
# 不带 NEXT_PUBLIC_ 的（SERVER_API_BASE_URL / SITE_URL / REVALIDATE_SECRET）是运行时读的，重启即可。

# =====================================
# 站点地址（当前线上漏配 —— sitemap / robots / RSS 全在输出 localhost，见 docs/DEPLOY.md）
# =====================================
NEXT_PUBLIC_SITE_URL=http://meblog.bugooai.cn
SITE_URL=http://meblog.bugooai.cn
#
# 2026-10-15 更新：前端 getSiteUrl() 现在把**运行时**的 SITE_URL 排在前面，
# NEXT_PUBLIC_SITE_URL 只作为构建时烘进产物的兜底。也就是说改域名不再非得重构建
# 镜像（robots.txt 例外，它是构建时生成的静态文件）。
# 另一个坑：Next 读 env 文件的优先级是 .env.local 高于 .env.production，
# 服务器上 frontend/ 里残留的 .env.local 会盖住这份文件 —— 部署前看一眼。

# =====================================
# 后端地址
# =====================================
# 浏览器侧：留默认相对路径 /api/v1 就行 —— nginx 把域名的 /api/* 整段转给 FastAPI，同源最稳，
# 换域名也不用改这里。（client.ts:3 的默认值就是 '/api/v1'）
# NEXT_PUBLIC_API_BASE_URL=http://meblog.bugooai.cn/api/v1

# Next.js 服务端取数（RSC/ISR 用）：走容器间地址，别绕出去再穿 nginx。
# 如果线上现在就能取到文章，保留你们已有的值，只加上面 SITE_URL 两行。
SERVER_API_BASE_URL=http://meblog-backend-prod:8000/api/v1
# next.config.ts 的 /api 代理目标（同源部署下基本用不到，留着防止 rewrite 兜底成占位域名）
NEXT_PUBLIC_API_ORIGIN=http://meblog-backend-prod:8000
NEXT_PUBLIC_ENV=production

# =====================================
# 发文后即时刷新首页缓存
# =====================================
# 必须等于后端 .env.production 里的 FRONTEND_REVALIDATE_TOKEN。
# 不设则该接口一律 401，首页最长 180 秒后才更新（app/page.tsx 里 revalidate = 180）。
REVALIDATE_SECRET=FILL-IN-shared-secret

# 封面图兜底前缀（可选，方案 A：从 git 仓库 raw 地址取图）
# NEXT_PUBLIC_GITEE_ASSETS_BASE=

# CMP-14 自测：故意塞一个旧拼法，验证 CI 门禁会红。这个分支合不进去。
NEXT_PUBLIC_API_ORIGIN=http://memblog-backend-prod:8000
