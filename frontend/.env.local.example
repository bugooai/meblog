# meblog 前端本地环境变量（复制成 frontend/.env.local）
#
# 结论：pnpm dev 一个变量都不缺就能跑。
# next.config.ts 在开发模式把后端地址硬编码为 http://127.0.0.1:8000，
# 并且浏览器请求走 /api/v1 同源代理，所以本地不用配 API 地址、也不会碰到 CORS。

# 只在需要"后端发文后前端立刻刷新缓存"时设置。
# 必须等于 backend/.env.local 里的 FRONTEND_REVALIDATE_TOKEN，否则刷新接口返回 401。
REVALIDATE_SECRET=change-me

# 站点地址（影响 metadataBase / canonical / og:url / sitemap.xml 里的绝对地址）。
# 本地默认就是 http://localhost:3000，可以留空。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 封面图兜底：把封面放在 Gitee 仓库 raw 上时用，留空则只用内置占位图。
# 例：https://gitee.com/<user>/<repo>/raw/main/covers
NEXT_PUBLIC_GITEE_ASSETS_BASE=

# ---------------------------------------------
# 下面这些本地开发不用设，只在 test / production 构建时需要
# ---------------------------------------------
# NEXT_PUBLIC_ENV=production
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1
# SERVER_API_BASE_URL=https://api.yourdomain.com/api/v1
# NEXT_PUBLIC_API_ORIGIN=https://api.yourdomain.com
# SITE_URL=https://yourdomain.com
