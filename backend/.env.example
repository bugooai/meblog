# =====================================
# meblog 后端环境变量模板
# =====================================
# 本文件只是清单，服务不会读它。按 APP_ENV 复制成对应文件才会生效：
#   APP_ENV=local      -> backend/.env.local      （本地开发，见 .env.local.example，逐项解释更全）
#   APP_ENV=test       -> backend/.env.test       （docker-compose-backend-test.yml）
#   APP_ENV=production -> backend/.env.production （docker-compose-backend-production.yml）
#
# 两个必须知道的坑：
# 1. env 文件按「当前工作目录」查找，必须在 backend/ 目录里启动服务，否则静默用代码默认值。
# 2. 系统环境变量优先级高于 env 文件。shell 里残留的 DATABASE_URL 会盖掉文件内容，
#    而服务启动时无条件建表 —— 等于往别的库里写表。启动前确认 DATABASE_URL 是空的。

# =====================================
# 1) 必填（不填就是拿默认值裸奔）
# =====================================
# 默认 sqlite:///./meblog.db。用 PostgreSQL 时请自行建库并改地址，口令用环境变量注入，
# 不要写进仓库（有回归测试拦截：backend/tests/test_no_hardcoded_credentials.py）。
# 走 docker-compose（common-postgres 网络）时，主机名写服务名而不是 IP：
#   DATABASE_URL=postgresql://<db-user>:<db-password>@common-postgres:5432/meblog
# 顺带修掉原模板里的拼写错误：生产示例写成 memblog（多一个 m）。
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:<db-port>/meblog

# 跑后端测试用，backend/tests/conftest.py:21 真的读它。默认内存 SQLite，不需要外部库。
TEST_DATABASE_URL=sqlite:///:memory:

# JWT 签名密钥。默认值是公开的占位串，保留它等于任何人都能伪造登录 token。
# 生成一个：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 改了会让所有人重新登录。
SECRET_KEY=change-me

# =====================================
# 2) 强烈建议（不设也能跑，但行为不完整）
# =====================================
APP_ENV=production

# 后端生成 /sitemap.xml、/feed.xml、og:image 时用的站点地址。
# 留默认值 = 所有 SEO 输出都指向 localhost，爬虫拿到的链接全是废的。
SITE_URL=https://yourdomain.com

# 允许跨域携带凭证的前端来源，逗号分隔。
# 前端走 Next.js 同源代理（/api/v1）时可不设；浏览器直连后端 8000 时必须包含对应来源。
BACKEND_CORS_ORIGINS=https://yourdomain.com

# 发文/改文后通知前端刷新 ISR 缓存。留空 = 不通知，首页最长 180 秒后才更新。
# FRONTEND_REVALIDATE_TOKEN 必须等于前端环境变量里的 REVALIDATE_SECRET。
FRONTEND_REVALIDATE_URL=https://yourdomain.com/api/internal/revalidate
FRONTEND_REVALIDATE_TOKEN=change-me

# 公开注册开关。保持 false：空库时第一个账号仍可注册（你初始化用），之后注册关闭。
# 警告：设成 true 等于任何人都能把自己注册成管理员 —— 建号 DAO 把 is_admin 写死成 True
# （backend/app/dao/admin.py:54），而公开 /auth/register 是唯一建号入口，没有受控的加号接口。
# 需要第二个管理员时，先用管理员账号登录后由后台/命令行授权，别放开这个开关。
ALLOW_REGISTRATION=false

# =====================================
# 3) 只有要上传图片/附件时才需要
# =====================================
# 四项（ENDPOINT / ACCESS_KEY_ID / ACCESS_KEY_SECRET / BUCKET）缺任一，
# POST /api/v1/files/upload 直接 500：OSS config missing: ...
OSS_PROVIDER=aliyun_oss
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 把 oss:// 地址换成可外链前缀；不设则返回签名地址
OSS_PUBLIC_BASE_URL=
OSS_SIGN_EXPIRE_SECONDS=3600
# 单次上传上限（MB），超限返回 413。分块读并在越限时立刻断开，
# 不会把整个文件读进内存（原来是无条件 file.read()，大文件能直接把进程打挂）。
MAX_UPLOAD_SIZE_MB=20

# =====================================
# 4) 当前代码根本不读取，别浪费时间填
# =====================================
# REDIS_URL      —— configs/base.py 声明了字段，但 app/ 里零引用，pyproject 也没有 redis 依赖，
#                   四个 docker-compose 文件里都没有 redis 服务。不需要装 Redis。
# ALLOWED_HOSTS  —— 没有 TrustedHostMiddleware，写了也不生效。
# DEBUG          —— 没有引用，日志级别写死在 app/utils/logger.py。
# 这三项原本以「必须配置」的样子出现在本文件里，会误导人去做无用功，已挪到这里说明。
