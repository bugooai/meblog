# meblog 后端生产环境变量（复制到服务器上的 backend/.env.production）
# 站点：http://meblog.bugooai.cn  （nginx/1.18.0 Ubuntu -> 前端 9001 / 后端 9000）
# 注意：APP_ENV=production 时读 .env.production，且必须在 backend/ 目录下启动服务才找得到文件。
#
# 这份文件里的地址都是实测出来的，照抄即可；只有 3 处需要你填真值（标了 FILL-IN）。

# =====================================
# 必填
# =====================================
# FILL-IN：那台机上的库。地址和口令用环境变量注入，不要写进仓库（有回归测试拦截）。
# 提醒：现在博客和那个带泄露口令的测试库在同一台机（116.62.176.216），换口令时一起确认端口。
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:<db-port>/<db-name>

# FILL-IN：JWT 签名密钥。默认值是公开的占位串，线上必须换（换了所有人重新登录一次）。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=FILL-IN-random-32-bytes

# =====================================
# 站点地址（当前线上漏配，直接导致 SEO 全废，见 docs/DEPLOY.md）
# =====================================
# 后端生成 /sitemap.xml、/feed.xml 时用的地址。不设 = 输出 http://localhost:3000。
# 必须和根目录 .env 里前端那份完全一致，否则 canonical 和后端 sitemap 各说一套。
SITE_URL=http://meblog.bugooai.cn

# =====================================
# 缓存即时刷新
# =====================================
# 必须走容器间地址，不能用域名：域名上的 /api/* 被 nginx 整段转给 FastAPI，
# 而 /api/internal/revalidate 是前端的 Next 路由，走域名会拿到 FastAPI 的 404（已实测）。
FRONTEND_REVALIDATE_URL=http://meblog-frontend-prod:3000/api/internal/revalidate
# FILL-IN：必须等于前端 .env.production 里的 REVALIDATE_SECRET
FRONTEND_REVALIDATE_TOKEN=FILL-IN-shared-secret

# =====================================
# 其余（保持默认即可）
# =====================================
APP_ENV=production
# 浏览器直连后端时才需要；现在走 nginx 同源，可留默认。
BACKEND_CORS_ORIGINS=http://meblog.bugooai.cn
# 保持 false，但原因变了：注册不再送管理员权限（fcebeb0）—— 空库的第一个账号才是管理员，
# 之后注册的一律是一般账号，想加管理员只能由管理员调 POST /api/v1/admins。
# 现在开注册只是让人刷账号，一般账号除了登录没有任何专属能力（点赞/评论走匿名 IP）。
ALLOW_REGISTRATION=false
# OpenAPI 文档不用登录就能拿到全部路由与字段结构，生产保持默认（不出文档）。
# 要临时查接口再 EXPOSE_OPENAPI=true，用完撤掉。

# =====================================
# 图片/附件上传（缺四项中任一，POST /api/v1/files/upload 直接 500）
# =====================================
# 建议用只授 OSS 读写权限的 RAM 子账号，不要用主账号 AccessKey。
# 这四行只在服务器上手填，别贴进仓库、Issue 或聊天记录。
OSS_PROVIDER=aliyun_oss
OSS_ENDPOINT=oss-<region>.aliyuncs.com
OSS_ACCESS_KEY_ID=FILL-IN-on-server-only
OSS_ACCESS_KEY_SECRET=FILL-IN-on-server-only
OSS_BUCKET=FILL-IN-on-server-only
# 不设则返回签名地址；设了就用它拼公网直链（自定义域名或 bucket 域名）
OSS_PUBLIC_BASE_URL=
OSS_SIGN_EXPIRE_SECONDS=3600
# 单次上传上限（MB），超限返回 413
MAX_UPLOAD_SIZE_MB=20
