# meblog 后端本地环境变量（复制成 backend/.env.local）
# 只有 APP_ENV=local 时读取，且必须从 backend/ 目录启动服务才找得到这个文件。
#
# 结论：本地跑起来一个变量都不缺（下面全部有默认值）。
# 但请按下面顺序把该填的填上，尤其是 DATABASE_URL 和 OSS_*。

# =====================================
# 1) 必须显式设置（防止被外部环境变量劫持）
# =====================================
# 服务启动时会自动建表，写错地址等于写坏别人的库。
# 本地用 SQLite 即可，不需要 PostgreSQL，也不需要装 Redis。
DATABASE_URL=sqlite:///./meblog.db

# JWT 签名密钥。默认值是占位字符串，本地也建议换掉，否则 token 可被伪造。
# 生成一个：python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-local-only

# =====================================
# 2) 建议设置（不设也能跑，但行为不完整）
# =====================================
APP_ENV=local

# 后端生成的 sitemap.xml / feed.xml / og:image 用的站点地址
SITE_URL=http://localhost:3000

# 允许跨域携带凭证的前端来源，逗号分隔。
# 前端开发默认走 Next.js 同源代理（/api/v1），此项不设也行；
# 只有当浏览器直连 http://127.0.0.1:8000 时才必须包含对应来源。
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 发文/改文后通知前端刷新 ISR 缓存。留空 = 不通知（前端最长 180 秒后才更新）。
# FRONTEND_REVALIDATE_TOKEN 必须等于 frontend/.env.local 里的 REVALIDATE_SECRET。
FRONTEND_REVALIDATE_URL=http://127.0.0.1:3000/api/internal/revalidate
FRONTEND_REVALIDATE_TOKEN=change-me

# 注册开关。保持 false：库里没有账号时第一个账号仍可注册（你初始化用）。
ALLOW_REGISTRATION=false

# =====================================
# 3) 只有要上传图片/附件时才需要（缺了上传接口会 500）
# =====================================
# 未配置时 POST /api/v1/files/upload 报：
# OSS config missing: OSS_ENDPOINT/OSS_ACCESS_KEY_ID/OSS_ACCESS_KEY_SECRET/OSS_BUCKET
OSS_PROVIDER=aliyun_oss
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 公网访问前缀，用于把 oss:// 地址换成可外链地址；不设则返回签名地址
OSS_PUBLIC_BASE_URL=
OSS_SIGN_EXPIRE_SECONDS=3600

# =====================================
# 4) 当前代码没有读取，写不写都不影响（保留仅为兼容旧文档）
# =====================================
# REDIS_URL —— app/ 里没有任何引用，pyproject 也没有 redis 依赖
# ALLOWED_HOSTS —— 没有 TrustedHostMiddleware
# DEBUG —— 没有引用（日志级别写死在 app/utils/logger.py）
